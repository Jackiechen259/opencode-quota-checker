{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Quota Checker",
  "version": "0.1.2",
  "identifier": "io.github.jackiechen259.opencode-quota-checker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode Quota Checker",
        "width": 1440,
        "height": 900,
        "minWidth": 680,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libsecret-1-0",
          "libnotify4"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QzVGQjVGRjgyREY4MkIKUldRcitDMzRYL3ZGOUxyWXp2VHkzZEI5bzVOaVV6bUJtSVc2dDkvVll4eFh5L0FNQnUzZmtXRzUK",
      "endpoints": [
        "https://github.com/Jackiechen259/opencode-quota-checker/releases/latest/download/latest.json"
      ]
    }
  }
}
