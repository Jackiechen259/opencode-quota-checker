{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "center": true,
        "decorations": false,
        "height": 900,
        "label": "main",
        "minHeight": 620,
        "minWidth": 680,
        "resizable": true,
        "title": "OpenCode Quota Checker",
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libsecret-1-0",
          "libnotify4"
        ]
      }
    },
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    }
  },
  "identifier": "io.github.jackiechen259.opencode-quota-checker",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jackiechen259/opencode-quota-checker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNjhGQzNCOUM5NTBDRTkKUldUcERKV2NPL3hvSU1lbC9qRjY0Wm5nQWFITXpaL3VydlgvMGxwdkRaTlJFWGF3K0hqc3hMMlQK"
    }
  },
  "productName": "OpenCode Quota Checker",
  "version": "0.2.1"
}
