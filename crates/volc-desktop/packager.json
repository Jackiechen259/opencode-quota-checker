{
  "$schema": "https://raw.githubusercontent.com/crabnebula-dev/cargo-packager/main/schema.json",
  "name": "volc-status",
  "productName": "VOLC Status",
  "identifier": "io.github.jackiechen259.volc-status",
  "version": "0.2.0",
  "description": "Native desktop quota monitor for Volcano Ark Agent Plan",
  "longDescription": "Monitor Volcano Ark Agent Plan quota windows, alerts, and reset times from a native Rust desktop application.",
  "authors": ["Jackie Chen"],
  "publisher": "Jackie Chen",
  "homepage": "https://github.com/Jackiechen259/volc_status",
  "licenseFile": "../../LICENSE",
  "category": "Utility",
  "outDir": "../../target/packages",
  "binariesDir": "../../target/release",
  "binaries": [
    {
      "path": "volc-desktop",
      "main": true
    }
  ],
  "icons": [
    "../../assets/icons/32x32.png",
    "../../assets/icons/128x128.png",
    "../../assets/icons/128x128@2x.png",
    "../../assets/icons/icon.png",
    "../../assets/icons/icon.ico",
    "../../assets/icons/icon.icns"
  ],
  "formats": ["default"],
  "beforePackagingCommand": {
    "script": "cargo build --release -p volc-desktop",
    "dir": "../.."
  },
  "linux": {
    "generateDesktopEntry": true
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libayatana-appindicator3-1",
      "libsecret-1-0",
      "libnotify-bin"
    ]
  },
  "nsis": {
    "installMode": "currentUser",
    "languages": ["English", "SimpChinese"]
  }
}
